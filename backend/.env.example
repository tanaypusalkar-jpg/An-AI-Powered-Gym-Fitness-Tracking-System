# Copy this file to .env (or just set these as real environment variables)
# to turn on the optional real-AI/IoT integrations. Every one of these is
# optional -- the app runs fully without any of them, using rule-based
# fallbacks instead.

# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///./fitness.db

# Virtual Gym Buddy -- real LLM replies (Module 5)
# Requires: pip install openai
OPENAI_API_KEY=

# Smart Gym Assistant -- real MQTT/IoT listener (Module 3)
# Requires: pip install paho-mqtt
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883

# Gym Recommender -- real Google Places search (Module 7)
# Requires: pip install requests
GOOGLE_PLACES_API_KEY=
